{
  "name": "app-financeiro-v2",
  "version": "1.0.0",
  "description": "App de controle financeiro com IA",
  "type": "module",
  "scripts": {
    "start-local": "npm run dev:local",
    "dev:vercel": "vercel dev",
    "dev:local": "node scripts/prepare-local.js && npm run ui:build && node scripts/local-server.mjs",
    "ui:install": "npm install --prefix frontend",
    "ui:build": "npm run build --prefix frontend && node scripts/copy-frontend-build.js",
    "deploy": "vercel --prod",
    "vercel-build": "npm run ui:install && node scripts/generate-prisma.js && npm run db:sync:prod && npm run ui:build",
    "postinstall": "npm run ui:install && node scripts/generate-prisma.js || true",
    "prisma:studio": "npx prisma studio --schema lib/prisma/schema.prisma",
    "prisma:seed": "node lib/prisma/seed.js",
    "data:export": "node scripts/export-user-data.js",
    "test": "node --test test/*.test.js",
    "test:telegram": "node --test test/telegramWebhook.test.js",
    "db:sync:local": "dotenv -e .env.local -- prisma db push --schema lib/prisma/schema-fixed.prisma",
    "db:sync:prod": "prisma db push --schema lib/prisma/schema.prisma"
  },
  "prisma": {
    "schema": "lib/prisma/schema.prisma",
    "seed": "node lib/prisma/seed.js"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie": "^0.7.2",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.577.0",
    "pg": "^8.16.3",
    "prisma": "^5.22.0",
    "react": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "vercel": "^50.32.5"
  }
}
